#!/bin/sh

# The client pins every call to the endpoint `tsh status` reported, whatever
# profile the surrounding environment selects (see client/src/endpoint.rs).
if [ "$1" = "status" ]; then
    printf '%s\n' '{"active":{"profile_url":"https://fixture.example.com:443","username":"me@example.com","cluster":"fixture.example.com"}}'
    exit 0
fi
if [ "${TELEPORT_PROXY:-}" != fixture.example.com:443 ] || [ "${TELEPORT_CLUSTER:-}" != fixture.example.com ]; then
    printf 'fake tsh: unpinned call (TELEPORT_PROXY=%s):' "${TELEPORT_PROXY:-}" >&2
    printf ' %s' "$@" >&2
    printf '\n' >&2
    exit 98
fi

if [ "$1" = "beams" ] && [ "$2" = "ls" ]; then
    printf '%s\n' '[{"id":"managed-session-test","uuid":"11111111-2222-3333-4444-555555555555","owner":"test@example.com","expires":"2099-01-01T00:00:00Z"}]'
    exit 0
fi

# Profile launches create a Beam, copy the runtime and launch to it, then
# open the daemon's bridge alongside the interactive session.
if [ "$1" = "beams" ] && [ "$2" = "add" ]; then
    printf '%s\n' '{"id":"managed-session-test","uuid":"11111111-2222-3333-4444-555555555555","owner":"test@example.com","expires":"2099-01-01T00:00:00Z"}'
    exit 0
fi
if [ "$1" = "beams" ] && { [ "$2" = "exec" ] || [ "$2" = "scp" ]; }; then
    exit 0
fi
case " $* " in
    *" client-bridge"*)
        # No Beam daemon here: keep the bridge quiet until the test ends.
        exec sleep 30 ;;
esac

if [ "$1" = "ssh" ]; then
    # Exercise terminal state that the managed-session relay must preserve:
    # title/clipboard OSCs plus bracketed paste and SGR mouse modes.
    # Real multiplexers (zellij) never send RIS; BEAMS_TEST_NO_RIS=1 leaves
    # the overlay without the evidence it needs to paint.
    if [ "${BEAMS_TEST_NO_RIS:-0}" != 1 ]; then
        printf '\033c'
    fi
    printf '\033]2;REMOTE TITLE\007'
    printf '\033]52;c;SGVsbG8=\007'
    printf '\033[?1006h\033[?2004h'
    printf 'REMOTE READY\r\n'
    stty size
    trap 'printf "REMOTE RESIZE: "; stty size' WINCH
    IFS= read -r line
    printf 'REMOTE ECHO: %s\r\n' "$line"
    sleep 1 &
    child=$!
    while kill -0 "$child" 2>/dev/null; do
        wait "$child" || true
    done
    exit 7
fi

printf 'unexpected fake tsh invocation:' >&2
printf ' %s' "$@" >&2
printf '\n' >&2
exit 99
