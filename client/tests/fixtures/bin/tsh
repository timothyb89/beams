#!/bin/sh

if [ "$1" = "beams" ] && [ "$2" = "ls" ]; then
    printf '%s\n' '[{"id":"managed-session-test","uuid":"11111111-2222-3333-4444-555555555555","owner":"test@example.com","expires":"2099-01-01T00:00:00Z"}]'
    exit 0
fi

if [ "$1" = "ssh" ]; then
    # Exercise terminal state that the managed-session relay must preserve:
    # title/clipboard OSCs plus bracketed paste and SGR mouse modes.
    printf '\033c'
    printf '\033]2;REMOTE TITLE\007'
    printf '\033]52;c;SGVsbG8=\007'
    printf '\033[?1006h\033[?2004h'
    printf 'REMOTE READY\r\n'
    stty size
    trap 'printf "REMOTE RESIZE: "; stty size' WINCH
    IFS= read -r line
    printf 'REMOTE ECHO: %s\r\n' "$line"
    sleep 1 &
    child=$!
    while kill -0 "$child" 2>/dev/null; do
        wait "$child" || true
    done
    exit 7
fi

printf 'unexpected fake tsh invocation:' >&2
printf ' %s' "$@" >&2
printf '\n' >&2
exit 99
