#!/bin/bash
# ~/bin/beam-shell
#
# Convenience entrypoint for working on a beam: makes sure the ssh-agent is
# running (never blocks - see step 2 below), kicks off beam-bootstrap in
# the background logging to ~/.beam-bootstrap.log, then attaches to (or
# creates) a "beam" zellij session with a layout that keeps that log
# visible in a side pane, alongside another pane that handles the actual
# interactive key unlock whenever you get to it - see
# shell/zellij/beam-shell.kdl. Safe to run repeatedly - everything it does
# is idempotent.

set -euo pipefail

REPO="${BEAM_REPO:-$HOME/beams}"
LOG="$HOME/.beam-bootstrap.log"
SESSION="beam"
ZELLIJ_LAYOUT_DIR="$REPO/shell/zellij"
ZELLIJ_CONFIG="${XDG_CACHE_HOME:-$HOME/.cache}/beam-shell/zellij-config.kdl"

# The client (client/src/stage.rs) ships a cross-compiled build at the
# musl target path when it has one - that's the common case these days,
# since the client usually runs on macOS. Fall back to a native build for
# the case someone built in place on a beam directly (bootstrap/README.md).
BOOTSTRAP_BIN="$REPO/bootstrap/target/x86_64-unknown-linux-musl/release/beam-bootstrap"
[ -x "$BOOTSTRAP_BIN" ] || BOOTSTRAP_BIN="$REPO/bootstrap/target/release/beam-bootstrap"
[ -x "$BOOTSTRAP_BIN" ] || BOOTSTRAP_BIN="$REPO/bootstrap/target/debug/beam-bootstrap"

# 1. make sure ~/.ssh and ~/bin are in place before anything below needs
#    them - ssh-agent-init's default key path, and the stable key the repo
#    carries (link-files force-replaces beams' own default ~/.ssh with
#    it) - and that zellij itself is installed, since step 4 below execs
#    it immediately rather than waiting on the backgrounded full run. A
#    beam that's already been bootstrapped once has both already, so this
#    is just two quick idempotent checks; a genuinely fresh beam doesn't
#    have zellij yet at all, and without this, the `exec zellij` below
#    would race the background install and lose. Run each step
#    synchronously rather than duplicating its logic here; the full run
#    below (backgrounded) will just skip both the second time.
if [ -x "$BOOTSTRAP_BIN" ]; then
    "$BOOTSTRAP_BIN" --repo "$REPO" --only link-files
    "$BOOTSTRAP_BIN" --repo "$REPO" --only install-zellij
else
    echo "beam-shell: beam-bootstrap binary not found under $REPO/bootstrap/target - skipping" >>"$LOG"
fi

# 2. make sure the ssh-agent itself is running - but *not* the interactive
#    key unlock that's normally step 4 of ssh-agent-init, which belongs to
#    the dedicated "ssh-agent" pane in the zellij layout instead (so it's
#    available whenever you get to it, rather than blocking getting into
#    zellij at all). Redirecting stdin from /dev/null for just this one
#    command makes ssh-agent-init's own `[ -t 0 ]` interactivity check
#    false, same as any other noninteractive caller - it'll still find or
#    start the agent, just skip the unlock. Sourced (not exec'd) so the
#    agent's env ends up exported here, in beam-shell's own process,
#    which `exec zellij` below then hands down to every pane zellij spawns
#    - the dedicated pane just needs to run ssh-agent-init again itself
#    (ensure is instant once the agent's already up; unlock proceeds
#    normally there, since that pane *does* have a real tty).
# ssh-agent-init references $SSH_AUTH_SOCK etc. without ${VAR:-} guards,
# fine for a normal interactive shell but not under our `set -u` - relax
# it just for this sourced call.
set +u
# shellcheck disable=SC1091
source "$HOME/bin/ssh-agent-init" </dev/null
set -u

# 3. kick off the full bootstrap run in the background; the log pane in
#    the zellij layout tails $LOG.
if [ -x "$BOOTSTRAP_BIN" ]; then
    nohup "$BOOTSTRAP_BIN" --repo "$REPO" >>"$LOG" 2>&1 &
else
    echo "beam-shell: beam-bootstrap binary not found under $REPO/bootstrap/target - skipping" >>"$LOG"
fi

# 4. point zellij at the repo's beam-shell layout as this session's
#    default, via a generated config override rather than touching the
#    user's own zellij config. `attach --create` handles attach-or-create
#    on its own; a fresh create picks up this default layout, an existing
#    session is just attached to as-is.
mkdir -p "$(dirname "$ZELLIJ_CONFIG")"
cat >"$ZELLIJ_CONFIG" <<EOF
layout_dir "$ZELLIJ_LAYOUT_DIR"
default_layout "beam-shell"
EOF

exec zellij --config "$ZELLIJ_CONFIG" attach "$SESSION" --create
