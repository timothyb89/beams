#!/bin/bash
# ~/bin/beam-shell
#
# Convenience entrypoint for working on a beam: starts the bootstrap daemon
# (which also serves the SSH agent relay - see step 2), kicks off
# beam-bootstrap in the background logging to ~/.beam-bootstrap.log, then
# attaches to (or creates) a "beam" zellij session with a layout that keeps
# that log visible in a side pane next to a pane running `beam-bootstrap
# tui` against the daemon - see shell/zellij/beam-shell.kdl. Safe to run
# repeatedly - everything it does is idempotent.
#
# Startup tasks (repo clones, toolchains) are no longer submitted from
# here: the workstation's `beams` client sends its `[startup]` config over
# the bridge once it connects.

set -euo pipefail

REPO="${BEAM_REPO:-$HOME/beams}"
LOG="$HOME/.beam-bootstrap.log"
SESSION="beam"
ZELLIJ_LAYOUT_DIR="$REPO/shell/zellij"
ZELLIJ_CONFIG="${XDG_CACHE_HOME:-$HOME/.cache}/beam-shell/zellij-config.kdl"

# The client (client/src/stage.rs) ships a cross-compiled build at the
# musl target path when it has one - that's the common case these days,
# since the client usually runs on macOS. Fall back to a native build for
# the case someone built in place on a beam directly (bootstrap/README.md).
BOOTSTRAP_BIN="$REPO/bootstrap/target/x86_64-unknown-linux-musl/release/beam-bootstrap"
[ -x "$BOOTSTRAP_BIN" ] || BOOTSTRAP_BIN="$REPO/bootstrap/target/release/beam-bootstrap"
[ -x "$BOOTSTRAP_BIN" ] || BOOTSTRAP_BIN="$REPO/bootstrap/target/debug/beam-bootstrap"
# Exported so shell/zellij/beam-shell.kdl's tui pane can run the same
# binary without re-deriving this fallback chain itself (and without a
# zellij layout variable, same rationale as that file's own note on
# expanding $HOME in shell commands rather than relying on one).
export BEAM_BOOTSTRAP_BIN="$BOOTSTRAP_BIN"

# 1. make sure ~/.ssh and ~/bin are in place before anything below needs
#    them (link-files force-replaces beams' own default ~/.ssh with the
#    repo's, which carries known_hosts) - and that zellij and fish are
#    both installed, since step 4 below
#    execs zellij immediately rather than waiting on the backgrounded full
#    run (and zellij needs fish to already exist to use it for new panes -
#    see step 4's default_shell override). A beam that's already been
#    bootstrapped once has all of these already, so this is just a few
#    quick idempotent checks; a genuinely fresh beam doesn't have zellij
#    or fish yet at all. Run each step synchronously rather than
#    duplicating its logic here; the full run below (backgrounded) will
#    just skip all of them the second time.
if [ -x "$BOOTSTRAP_BIN" ]; then
    "$BOOTSTRAP_BIN" --repo "$REPO" --only link-files
    "$BOOTSTRAP_BIN" --repo "$REPO" --only install-zellij
    "$BOOTSTRAP_BIN" --repo "$REPO" --only apt-install
    # Doesn't help *this* zellij session (see step 4's default_shell
    # override for why) but worth doing now anyway, so a plain `tsh ssh`
    # straight into the beam - no beam-shell at all - gets fish on its
    # next connection rather than waiting on the backgrounded full run.
    "$BOOTSTRAP_BIN" --repo "$REPO" --only default-shell
    # Also synchronous, for the same reason as the others: the zellij
    # layout's tui pane (see shell/zellij/beam-shell.kdl) connects to
    # this daemon the moment zellij starts in step 4 below, so it needs
    # to already be listening by then, not just "eventually" via the
    # backgrounded full run in step 3. (`tui`'s own connect retries
    # briefly regardless - see `tui::connect_with_retry` - this is about
    # not relying on that race resolving in our favor, not a strict
    # requirement for it to work at all.)
    "$BOOTSTRAP_BIN" --repo "$REPO" --only start-bootstrap-daemon
else
    echo "beam-shell: beam-bootstrap binary not found under $REPO/bootstrap/target - skipping" >>"$LOG"
fi

# 2. every process started from here (zellij and its panes) uses the
#    daemon's SSH agent relay, which holds no keys: each signature is
#    approved on the workstation, in the attached `beams ssh` session (see
#    SSH_AGENT_PROXY_DESIGN.md). fish's config.fish sets the same for
#    shells started any other way.
export SSH_AUTH_SOCK="$HOME/.beam-bootstrap/ssh-agent.sock"
export TELEPORT_ADD_KEYS_TO_AGENT=no

# 3. kick off the full bootstrap run in the background; the log pane in
#    the zellij layout tails $LOG.
if [ -x "$BOOTSTRAP_BIN" ]; then
    nohup "$BOOTSTRAP_BIN" --repo "$REPO" >>"$LOG" 2>&1 &
else
    echo "beam-shell: beam-bootstrap binary not found under $REPO/bootstrap/target - skipping" >>"$LOG"
fi

# 4. point zellij at the repo's beam-shell layout as this session's
#    default, via a generated config override rather than touching the
#    user's own zellij config. `attach --create` handles attach-or-create
#    on its own; a fresh create picks up this default layout, an existing
#    session is just attached to as-is.
#
#    Also explicitly set default_shell to fish (once step 1 above has
#    installed it) for the panes zellij spawns on its own (the main pane
#    here, any new pane/tab you open later) - zellij otherwise falls back
#    to $SHELL, which sshd/PAM set from the passwd entry at *connection*
#    time. On a beam's very first bootstrap, that's still whatever shell
#    was configured before this run (bash) - chsh flipping the passwd
#    entry moments later, even synchronously and before this point,
#    doesn't retroactively update an already-exported env var in this
#    process. Overriding it explicitly here is what actually makes zellij
#    use fish from this session's first pane onward, rather than only
#    after a later reconnect.
mkdir -p "$(dirname "$ZELLIJ_CONFIG")"
cat >"$ZELLIJ_CONFIG" <<EOF
layout_dir "$ZELLIJ_LAYOUT_DIR"
default_layout "beam-shell"
EOF
FISH_BIN="$(command -v fish || true)"
if [ -n "$FISH_BIN" ]; then
    echo "default_shell \"$FISH_BIN\"" >>"$ZELLIJ_CONFIG"
fi

exec zellij --config "$ZELLIJ_CONFIG" attach "$SESSION" --create
