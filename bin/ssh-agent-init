#!/bin/bash
# ~/.ssh/agent-init.sh
# Usage: source ~/.ssh/agent-init.sh [path_to_private_key]
#
# Steps 1-3 (find or start the agent) always run, interactive or not - safe
# to source from anywhere, including a noninteractive `tsh ssh ... -- cmd`.
# Step 4 (unlock + ssh-add the key, which may prompt for a passphrase) only
# runs when stdin/stdout are both a tty - a noninteractive session just gets
# a running agent with whatever keys it already holds, rather than hanging
# on (or erroring out of) a password prompt nobody can answer.

_setup_ssh_agent() {
    local key_file="${1:-$HOME/.ssh/beams_id_ed25519}"
    local env_file="${XDG_RUNTIME_DIR:-$HOME/.ssh}/agent.env"

    # 1. Load saved environment if SSH_AUTH_SOCK is unset or stale
    if [ -z "$SSH_AUTH_SOCK" ] && [ -f "$env_file" ]; then
        . "$env_file" >/dev/null 2>&1
    fi

    # 2. Test if the socket is alive and responsive
    local agent_status=2
    if [ -n "$SSH_AUTH_SOCK" ]; then
        ssh-add -l >/dev/null 2>&1
        agent_status=$?
    fi

    # 3. If unreachable (status 2), clean up and spawn a new agent
    if [ "$agent_status" -eq 2 ]; then
        pkill -u "$USER" -x ssh-agent 2>/dev/null
        mkdir -p "$(dirname "$env_file")"
        ssh-agent -s > "$env_file"
        chmod 600 "$env_file"
        . "$env_file" >/dev/null
    fi

    # 4. Check key presence and import if not already loaded - only when
    #    interactive, so a noninteractive caller never hits a password
    #    prompt it can't answer.
    if [ ! -f "$key_file" ]; then
        echo "ssh-agent: Key not found at $key_file" >&2
    elif [ -t 0 ] && [ -t 1 ]; then
        local key_fp
        key_fp=$(ssh-keygen -lf "$key_file" 2>/dev/null | awk '{print $2}')

        if ! ssh-add -l 2>/dev/null | grep -qF "$key_fp"; then
            ssh-add "$key_file"
        fi
    fi
    # else: noninteractive and the key isn't loaded yet - leave it locked.
    # Whatever needs it (ssh, git) will fail with its own clear error
    # instead of blocking on an unanswerable prompt.
}

_setup_ssh_agent "$@"
unset -f _setup_ssh_agent
