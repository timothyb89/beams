#!/bin/bash
# Beam-side `beams` command (`beams fetch ...`). Resolves the same shipped/
# native bootstrap binary variants as beam-client-bridge, then runs it under
# the name `beams`, which selects its Beam-side CLI.

set -euo pipefail

REPO="${BEAM_REPO:-$HOME/beams}"
BOOTSTRAP_BIN="$REPO/bootstrap/target/x86_64-unknown-linux-musl/release/beam-bootstrap"
[ -x "$BOOTSTRAP_BIN" ] || BOOTSTRAP_BIN="$REPO/bootstrap/target/release/beam-bootstrap"
[ -x "$BOOTSTRAP_BIN" ] || BOOTSTRAP_BIN="$REPO/bootstrap/target/debug/beam-bootstrap"

if [ ! -x "$BOOTSTRAP_BIN" ]; then
    echo "beams: beam-bootstrap binary not found under $REPO/bootstrap/target" >&2
    exit 1
fi

exec -a beams "$BOOTSTRAP_BIN" "$@"
