#!/bin/bash
# Stable remote command used by the workstation `beams` daemon. Resolve the
# same shipped/native bootstrap binary variants as beam-shell, then replace
# this shell with its stdio bridge.

set -euo pipefail

REPO="${BEAM_REPO:-$HOME/beams}"
BOOTSTRAP_BIN="$REPO/bootstrap/target/x86_64-unknown-linux-musl/release/beam-bootstrap"
[ -x "$BOOTSTRAP_BIN" ] || BOOTSTRAP_BIN="$REPO/bootstrap/target/release/beam-bootstrap"
[ -x "$BOOTSTRAP_BIN" ] || BOOTSTRAP_BIN="$REPO/bootstrap/target/debug/beam-bootstrap"

if [ ! -x "$BOOTSTRAP_BIN" ]; then
    echo "beam-client-bridge: beam-bootstrap binary not found under $REPO/bootstrap/target" >&2
    exit 1
fi

exec "$BOOTSTRAP_BIN" client-bridge "$@"
