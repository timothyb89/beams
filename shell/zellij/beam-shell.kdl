// Layout used by bin/beam-shell. A main interactive pane, a smaller pane
// tailing ~/.beam-bootstrap.log (so bootstrap progress - and anything
// future async steps print, teleport clone, go toolchain install, etc. -
// stays visible without taking over the whole terminal), and a third pane
// that ensures the ssh-agent is running and unlocks its key.
//
// That third pane isn't focused by default - it doesn't need to be.
// Finding/starting the agent never blocks (bin/ssh-agent-init), and the
// password prompt for the key itself just sits there waiting in its own
// pane until you switch over and answer it, whenever that is; nothing
// else depends on it being unlocked immediately. Falls through to an
// interactive shell afterward rather than exiting, so the pane stays
// useful either way.
//
// $HOME is expanded by the shell commands below rather than relying on
// zellij layout variables, since the beams user is always /home/beams but
// this keeps it correct if that ever changes.
layout {
    pane split_direction="horizontal" {
        pane
        pane split_direction="vertical" size="25%" {
            pane {
                command "bash"
                args "-lc" "touch \"$HOME/.beam-bootstrap.log\" && tail -n +1 -f \"$HOME/.beam-bootstrap.log\""
            }
            pane name="ssh-agent" {
                command "bash"
                args "-lc" "\"$HOME/bin/ssh-agent-init\"; exec bash"
            }
        }
    }
}
