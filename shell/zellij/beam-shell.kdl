// Layout used by bin/beam-shell. Starts from the same tab-bar/status-bar
// chrome as zellij's own built-in "default" layout (`zellij setup
// --dump-layout default`) - a bare custom layout replaces that chrome
// entirely rather than inheriting it, which is why this repeats it here
// instead of just defining the content panes on their own.
//
// A flat `layout { pane ... }` (no explicit `tab` block) is used by
// zellij for BOTH the session's first tab *and*, implicitly, as the
// template for every tab opened afterward (ctrl+t) - confirmed by
// dumping a running session's actual layout
// (`~/.cache/zellij/contract_version_1/session_info/<name>/session-layout.kdl`),
// which showed this file's old flat form as the session's literal
// `new_tab_template`. That's the bug: every new tab re-ran the
// log-tail setup pointlessly (the log tail has nothing to do with
// whatever a new tab is actually for).
//
// Fix: give the first tab its content explicitly (`tab { ... }` below)
// and define a separate, minimal `new_tab_template` - zellij's actual
// mechanism for "what a new tab looks like", distinct from the first
// tab's own layout - for everything opened afterward. New tabs get
// zellij's stock single-pane shape (just the chrome + one pane), same
// as `zellij setup --dump-layout default`.
layout {
    tab name="beam-shell" {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane split_direction="vertical" {
            // The main shell. SSH key use goes through the daemon's agent
            // relay and is approved on the workstation (no unlock pane).
            pane size="70%" focus=true
            // Right-hand side: `beam-bootstrap tui` (see
            // bootstrap/src/tui/) stacked with the bootstrap log tail.
            // `stacked=true` collapses every pane but one to a single
            // title line - the tui is `expanded=true` so it's the one
            // left visible; the log pane is still right there as a
            // one-line tab to switch to (zellij's normal stacked-pane
            // navigation) without splitting the screen three ways by
            // default.
            pane size="30%" stacked=true {
                // Talks to the daemon bin/beam-shell starts
                // synchronously (step 1, before this layout even
                // launches) over its default UDS socket. Uses
                // $BEAM_BOOTSTRAP_BIN (exported by bin/beam-shell)
                // rather than re-deriving the cross-compiled-vs-native
                // binary path fallback chain here too.
                pane expanded=true name="bootstrap-tui" {
                    command "bash"
                    args "-lc" "\"$BEAM_BOOTSTRAP_BIN\" tui"
                }
                // Tails ~/.beam-bootstrap.log, so bootstrap progress -
                // and anything future async steps print, teleport
                // clone, go toolchain install, etc. - stays visible
                // without taking over the whole terminal.
                pane name="bootstrap-log" {
                    command "bash"
                    args "-lc" "touch \"$HOME/.beam-bootstrap.log\" && tail -n +1 -f \"$HOME/.beam-bootstrap.log\""
                }
            }
        }
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    new_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }
}
